<script>
(function(){
  document.documentElement.classList.add('js');

  // Pages: the link's #home, #meta or #google decides which page shows
  var pages=Array.prototype.slice.call(document.querySelectorAll('.page'));
  var navs=Array.prototype.slice.call(document.querySelectorAll('[data-nav]'));
  var names=pages.map(function(p){return p.getAttribute('data-name');});
  var current='home';
  function go(name,toTop){
    current=name;
    pages.forEach(function(p){p.hidden=p.getAttribute('data-name')!==name;});
    navs.forEach(function(a){
      if(a.getAttribute('data-nav')===name)a.setAttribute('aria-current','page');
      else a.removeAttribute('aria-current');
    });
    if(toTop)window.scrollTo(0,0);
  }
  function route(toTop){
    var h=location.hash.replace('#','');
    if(names.indexOf(h)>=0)go(h,toTop);
    else go(current,false);
  }
  window.addEventListener('hashchange',function(){route(true);});
  route(false);

  // Switchers: the client row and each client's ad row work independently
  Array.prototype.forEach.call(document.querySelectorAll('[role=tablist]'),function(list){
    var tabs=Array.prototype.slice.call(list.children).filter(function(el){return el.getAttribute('role')==='tab';});
    function show(i,focus){
      tabs.forEach(function(t,n){
        var on=n===i;
        t.setAttribute('aria-selected',on?'true':'false');
        t.tabIndex=on?0:-1;
        document.getElementById(t.getAttribute('aria-controls')).hidden=!on;
      });
      if(focus)tabs[i].focus();
    }
    tabs.forEach(function(t,i){
      t.addEventListener('click',function(){show(i);});
      t.addEventListener('keydown',function(e){
        if(e.key==='ArrowRight')show((i+1)%tabs.length,true);
        if(e.key==='ArrowLeft')show((i-1+tabs.length)%tabs.length,true);
      });
    });
    if(tabs.length)show(0);
  });

  // Headline picker: clicking a headline puts it into that ad
  Array.prototype.forEach.call(document.querySelectorAll('.pick'),function(g){
    var hl=g.closest('.sample').querySelector('.hl');
    var btns=Array.prototype.slice.call(g.querySelectorAll('button'));
    btns.forEach(function(b){
      b.addEventListener('click',function(){
        btns.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});
        hl.textContent=b.textContent;
      });
    });
  });
})();
</script>

