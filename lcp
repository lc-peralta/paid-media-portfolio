<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="only light">
<title>Llord Christian Peralta, paid media specialist</title>
<meta name="description" content="Paid media specialist on Meta and Google Ads, with recent work for a wellness clinic, a dental clinic and a DTC supplement brand.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<!-- Direct links: portfolio.html#meta opens the Meta ads page, portfolio.html#google opens the Google Ads page. -->
<style>
:root{
  color-scheme:only light;
  --paper:#E6EAEE; --sheet:#FBFCFD; --ink:#17212F; --muted:#566273;
  --rule:#C5CDD6; --mark:#9FE8C5; --bar:#000;
  --display:"Bricolage Grotesque",system-ui,sans-serif;
  --text:"Source Serif 4",Georgia,serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:1.0625rem/1.65 var(--text)}
a{color:inherit;text-underline-offset:.2em}
a:focus-visible,button:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
p{max-width:62ch;margin:0 0 1rem}
dt{font-size:.875rem;color:var(--muted)}
dd{margin:0}
.wrap{max-width:66rem;margin:0 auto;padding:0 1.5rem}

/* Redaction bar. Set its length with --w. */
.bar{display:inline-block;width:var(--w,6ch);height:.72em;background:var(--bar);border-radius:1px;vertical-align:-.02em}
/* Highlight color. Change --mark above to recolor highlights and selected buttons. */
mark{background:var(--mark);color:var(--ink);padding:.05em .3em}

/* Header and page links */
.top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem 2rem;padding-top:1.25rem;padding-bottom:1.25rem;font-family:var(--display);border-bottom:1px solid var(--rule)}
.top .name{font-weight:700;text-decoration:none}
.top nav{display:flex;flex-wrap:wrap;gap:.25rem}
.top nav a{text-decoration:none;padding:.3rem .7rem;border-radius:2px}
.top nav a:hover{text-decoration:underline}
.top nav a[aria-current=page]{background:var(--mark);font-weight:600;text-decoration:none}
.page[hidden]{display:none}

.hero{padding-top:4rem;padding-bottom:4rem}
.hero h1{font:700 clamp(2.25rem,6.2vw,4.5rem)/1.06 var(--display);letter-spacing:-.02em;max-width:20ch;margin:0 0 2rem}
.hero .lede{font-size:1.25rem;line-height:1.55;max-width:52ch}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.5rem;margin-top:2rem;font-family:var(--display)}
.btn{display:inline-block;background:var(--ink) !important;color:#fff !important;-webkit-text-fill-color:#fff;padding:.7rem 1.25rem;border-radius:2px;font-weight:600;text-decoration:none}
.btn:hover{background:#000 !important}
.note{border-left:6px solid var(--bar);padding:.25rem 0 .25rem 1.25rem;margin-top:3.5rem;max-width:60ch;color:var(--muted)}
.note strong{color:var(--ink)}

.pagehead{padding:3.5rem 0 3rem}
.pagehead h2{font:700 clamp(2rem,5vw,3.25rem)/1.08 var(--display);letter-spacing:-.02em;margin:0 0 1rem}
.pagehead p{font-size:1.2rem;line-height:1.55;max-width:54ch;margin:0}

.row{display:grid;grid-template-columns:11rem minmax(0,1fr);gap:1.5rem 3rem;padding:4rem 0;border-top:1px solid var(--rule)}
.row>h2{font:600 1.25rem/1.2 var(--display);margin:0}

.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:1.5rem 2rem;margin:0}
.facts dd{font:700 1.75rem/1.2 var(--display)}

/* Work cards on the home page */
.work{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1rem}
.card{display:block;background:var(--sheet);border:1px solid var(--rule);padding:1.5rem;text-decoration:none}
.card:hover{border-color:var(--muted)}
.card h3{font:700 1.5rem/1.2 var(--display);margin:0 0 .5rem}
.card .stat{font:700 1.25rem/1.2 var(--display);margin:1rem 0}
.card .go{font-family:var(--display);font-weight:600;text-decoration:underline;text-underline-offset:.2em;margin:0}

/* Buttons: text is always dark, selected items use the highlight color */
button{-webkit-appearance:none;appearance:none;font-family:var(--display);cursor:pointer;line-height:1.4;color:var(--ink) !important;-webkit-text-fill-color:var(--ink)}

/* Switchers. Hidden until the script runs, so the page still works without it. */
.tabs{display:none;flex-wrap:wrap;gap:.5rem;margin-bottom:1.5rem}
.js .tabs{display:flex}
.tabs button{font-weight:600;font-size:1rem;padding:.5rem .95rem;border:1px solid var(--rule);border-radius:2px;background:var(--sheet) !important}
.tabs button:hover{border-color:var(--muted)}
.tabs button[aria-selected=true],.tabs button[aria-selected=true]:hover{background:var(--mark) !important;border-color:var(--mark)}
.clients{margin-bottom:1rem}
.clients button{font-size:1.125rem;font-weight:700;padding:.65rem 1.1rem}
.client-name{font:700 1.5rem/1.2 var(--display);margin:2.5rem 0 1rem}
.js .client-name{display:none}

.sample{display:grid;grid-template-columns:minmax(0,23rem) minmax(0,1fr);gap:1.5rem 2.5rem;align-items:start;margin-bottom:2.5rem}
.js .sample{margin-bottom:0}
.sample[hidden]{display:none}
.adunit{background:var(--sheet);border:1px solid var(--rule);font-family:var(--display);line-height:1.45}
.adunit p{margin:0}
.adunit .tag{font-size:.75rem;color:var(--muted);padding:0 1rem}
.adunit .who{padding:1rem 1rem .75rem;font-weight:600}
.adunit .who small{display:block;font-weight:400;font-size:.8125rem;color:var(--muted)}
.adunit .body{padding:.15rem 1rem 1rem}
.adunit .visual{background:#000 !important;padding:2.5rem 0 1rem}
.adunit .visual .tag{color:#fff !important;-webkit-text-fill-color:#fff}
.adunit .base{padding:.85rem 0 1rem}
.adunit .hl{font-weight:700;font-size:1.125rem;line-height:1.25;padding:.15rem 1rem 0}
.notes{display:grid;gap:1rem;margin:0}

/* Metrics */
.roas{font:700 2rem/1.1 var(--display);margin:0 0 1.25rem}
.metrics{display:grid;grid-template-columns:1fr 1fr;gap:1rem 1.5rem;margin:0 0 1.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--rule)}
.metrics dd{font:700 1.35rem/1.2 var(--display);font-variant-numeric:tabular-nums}

/* Headline picker */
.pick{grid-column:1/-1;border-top:1px solid var(--rule)}
.pick p{font:600 1rem/1.3 var(--display);margin:1rem 0 .5rem}
.pick button{display:block;width:100%;text-align:left;background:transparent !important;border:0;border-bottom:1px solid var(--rule);border-radius:0;padding:.65rem .75rem;font-size:1rem;font-weight:600}
.pick button:hover{background:var(--sheet) !important}
.pick button[aria-pressed=true],.pick button[aria-pressed=true]:hover{background:var(--mark) !important}

/* Headline angles */
h3.sub{font:700 1.35rem/1.2 var(--display);margin:3rem 0 .5rem}
.angle{border-top:1px solid var(--rule);padding:1.25rem 0 .5rem}
.angle h4{font:600 1.125rem/1.3 var(--display);margin:0 0 .25rem}
.angle .focus{color:var(--muted);margin:0 0 .85rem}
.heads{list-style:none;margin:0;padding:0;font-family:var(--display)}
.heads li{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;background:var(--sheet);border:1px solid var(--rule);padding:.65rem .85rem;margin-top:-1px}
.heads .h{font-weight:700;font-size:1.125rem;line-height:1.3}
.heads .r{white-space:nowrap;font-variant-numeric:tabular-nums}

/* Google Ads page */
.camps{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1rem}
.camp{background:var(--sheet);border:1px solid var(--rule);padding:1.25rem}
.camp h4{font:600 1.05rem/1.3 var(--display);margin:0 0 .75rem}
.camp .roas{font-size:1.75rem;margin-bottom:1rem}
.camp .metrics{margin:0;padding:0;border:0}
.scroll{overflow-x:auto}
table{width:100%;min-width:33rem;border-collapse:collapse;font-family:var(--display);font-variant-numeric:tabular-nums;font-size:.95rem}
th,td{text-align:left;padding:.55rem .75rem .55rem 0;border-bottom:1px solid var(--rule)}
thead th{font-weight:500;font-size:.8125rem;color:var(--muted)}
tbody th{font-weight:600}
.num{text-align:right;padding-right:0;padding-left:.75rem;white-space:nowrap}
tr.grp th{font-size:.8125rem;font-weight:500;color:var(--muted);padding-top:1.1rem}
.kwgroups{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1.25rem 2rem;margin:0}
.kwgroups h4{font:600 1rem/1.3 var(--display);margin:0 0 .35rem}
.kwgroups ul{margin:0;padding-left:1.1rem;font-family:var(--display);font-size:.95rem}

.steps{list-style:none;counter-reset:s;padding:0;margin:0;display:grid;gap:1.5rem}
.steps li{counter-increment:s;display:grid;grid-template-columns:2.75rem 1fr}
.steps li::before{content:counter(s);font:700 1.5rem/1.2 var(--display)}
.steps h3{font:600 1.125rem/1.35 var(--display);margin:0 0 .15rem}
.steps p{margin:0}

.kit{display:grid;gap:1.25rem;margin:0}
.ways dt{font:600 1.125rem/1.35 var(--display);color:var(--ink)}
.ways dd{max-width:58ch}

.certs{list-style:none;margin:0;padding:0;display:grid;gap:1.35rem}
.certs h3{font:600 1.125rem/1.35 var(--display);margin:0}
.certs p{margin:.1rem 0 0;color:var(--muted)}
.certs .id{font-size:.8125rem;word-break:break-all}
.certs .topics{color:var(--ink);margin-top:.6rem}

.contact p.big{font:700 clamp(1.5rem,3.5vw,2.25rem)/1.2 var(--display);max-width:24ch;margin-bottom:1.5rem}
.contact .links{display:flex;flex-wrap:wrap;gap:.75rem 2rem;font-family:var(--display);font-size:1.125rem}
.foot{padding-top:2rem;padding-bottom:3rem;border-top:1px solid var(--rule);color:var(--muted);font-size:.9rem}

@media (max-width:46rem){
  .row{grid-template-columns:minmax(0,1fr);padding:2.75rem 0}
  .hero{padding-top:2.5rem;padding-bottom:2.5rem}
  .pagehead{padding:2.5rem 0 2rem}
  .sample{grid-template-columns:minmax(0,1fr)}
  .clients button{padding:.6rem .8rem;font-size:1rem}
}
</style>
</head>
<body>

<header class="wrap top">
  <a class="name" href="#home">Llord Christian Peralta</a>
  <nav aria-label="Pages">
    <a href="#home" data-nav="home" aria-current="page">Home</a>
