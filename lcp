<main class="wrap">

  <!-- ============ PAGE: HOME ============ -->
  <div class="page" data-name="home">

    <section class="hero">
      <h1>I run Meta ads for <span class="bar" style="--w:4.5ch" role="img" aria-label="a client I can't name"></span>, <span class="bar" style="--w:6.5ch" role="img" aria-label="another client I can't name"></span> and <span class="bar" style="--w:3.5ch" role="img" aria-label="a third client I can't name"></span>. The names are under NDA. The results aren't.</h1>
