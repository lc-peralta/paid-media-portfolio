  <!-- ============ PAGE: META ADS ============ -->
  <div class="page" data-name="meta">

    <div class="pagehead">
      <h2>Meta ads</h2>
      <p>Ad copy from client campaigns on Facebook and Instagram. The visuals belong to the clients, so they are withheld. Pick a client, then an ad.</p>
    </div>

    <section class="row" aria-labelledby="h-ads">
      <h2 id="h-ads">Ad copy</h2>
      <div>

